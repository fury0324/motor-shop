# Firebase Web SDK config — copy this file to .env.local and fill in the
# real values from Firebase Console > Project Settings > General > Your apps
# > SDK setup and configuration > Config. These are public client-side
# values (not secrets); access to your data is enforced by Firestore
# Security Rules, not by hiding this config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base URL of the Render-hosted API (see server/). Use http://localhost:3000
# for local dev (run `npm start` inside server/), or your Render service's
# URL once deployed (e.g. https://euro-motor-shop-api.onrender.com).
VITE_API_BASE_URL=http://localhost:3000
