# Firebase Admin SDK credentials — Console > Project Settings > Service
# Accounts > Generate new private key. Paste the ENTIRE downloaded JSON file
# content as a single-line string here. Never commit the real value.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Cloudinary — Dashboard > Account Details (cloudinary.com, free tier, no card).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenRouter — openrouter.ai/keys. Powers the AI Assistant chat (see
# server/src/routes/ai.js, aiTools.js, aiMemory.js and docs/ai-assistant.md).
# Optional: without OPENROUTER_API_KEY the endpoint returns a "not configured
# yet" error instead of 500ing.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional — model used for the periodic background memory-extraction call
# (aiMemory.js). Falls back to OPENROUTER_MODEL if unset; a cheaper/smaller
# model is fine here since it only summarizes, it doesn't answer the user.
OPENROUTER_MEMORY_MODEL=

# Comma-separated list of origins allowed to call this API (your Vite dev
# server + wherever the built app is actually hosted).
ALLOWED_ORIGINS=http://localhost:5173

# Shared secret GitHub Actions sends to trigger the two scheduled jobs.
# Generate any long random string.
CRON_SECRET=

PORT=3000
